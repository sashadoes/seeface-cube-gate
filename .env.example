# seeface1 world. Copy to .env.local (client) / server/.env (server). Never commit real values.

# --- client (Vite) ---
VITE_WORLD_WS=ws://localhost:8787
# comma list of flags to force on/off, e.g. "world,voice,radio,-coins"
VITE_WORLD_FLAGS=

# --- world server ---
WORLD_PORT=8787
WORLD_ALLOWED_ORIGINS=http://localhost:5173,https://seeface.world
WORLD_SECRET=change-me-long-random
# moderators' key for /admin/* and the admin queue page (world/admin/)
WORLD_ADMIN_KEY=

# voice
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URL=
TURN_USER=
TURN_PASS=

# speech-to-text (text only, audio is never stored)
STT_PROVIDER=mock
STT_API_KEY=

# AI host
ANTHROPIC_API_KEY=
HOST_MODEL=claude-opus-5-5
HOST_DAILY_CAP=2000

# storage
DATABASE_URL=

# payments (test mode only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# age assurance (vendor to be chosen by Sasha)
AGE_PROVIDER=mock
AGE_API_KEY=
AGE_WEBHOOK_SECRET=
</content>
</invoke>
